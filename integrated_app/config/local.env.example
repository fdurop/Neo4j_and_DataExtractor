# Copy to local.env and fill secrets locally. Never commit local.env.
APP_PORT=8769
APP_DATA_DIR=runtime
APP_SECRET_KEY=
DATABASE_MODE=neo4j
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.7-plus
ENABLE_PAID_PIPELINE=0
API_MAX_COST_YUAN=3
API_MAX_REQUESTS=100
MAX_PDF_PAGES=35

# Course vector retrieval; use the same model for documents and questions.
ENABLE_VECTOR_RETRIEVAL=0
PINECONE_API_KEY=
PINECONE_INDEX_NAME=multimodal-rag-index
PINECONE_NAMESPACE=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024

# Separate bounded ledgers for document jobs; QA retains its shared ledger.
PER_JOB_API_BUDGET=0

# Optional app-only HTTP proxy; leave empty when deploying without this local proxy.
OUTBOUND_HTTP_PROXY=
